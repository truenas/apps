                {
                    "variable": "aistor",
                    "label": "",
                    "group": "AIStor\u2122 Configuration",
                    "schema": {
                        "type": "dict",
                        "attrs": [
                            {
                                "variable": "license_key",
                                "label": "License Key",
                                "description": "License key for AIStor\u2122.</br>\nWithout a valid license, AIStor\u2122 starts in offline mode and all object storage (S3) operations are blocked until one is added.</br>\nGet one for free at https://www.min.io/pricing\n",
                                "schema": {
                                    "type": "string",
                                    "default": "",
                                    "required": true,
                                    "private": true
                                }
                            },
                            {
                                "variable": "console_url",
                                "label": "Console URL",
                                "description": "The URL that console will provide as a redirect URL</br>\nUsually the port is needed, unless you have a reverse proxy in front of AIStor\u2122.</br>\nFor example: </br>\n- https://console.example.com.</br>\n- https://minio1.example.com:31001\n",
                                "schema": {
                                    "type": "uri",
                                    "required": true
                                }
                            },
                            {
                                "variable": "credentials",
                                "label": "Credentials",
                                "description": "The credentials for the root user.",
                                "schema": {
                                    "type": "dict",
                                    "attrs": [
                                        {
                                            "variable": "access_key",
                                            "label": "AIStor\u2122 Root User",
                                            "description": "Root user with access to all actions and resources on the deployment. </br>\nIt doubles as the \"access key\" for the AIStor\u2122 deployment.\n",
                                            "schema": {
                                                "type": "string",
                                                "min_length": 5,
                                                "required": true,
                                                "private": true
                                            }
                                        },
                                        {
                                            "variable": "secret_key",
                                            "label": "AIStor\u2122 Root Password",
                                            "description": "Root password for the AIStor\u2122 root user.</br>\nIt doubles as the \"secret key\" for the AIStor\u2122 deployment.\n",
                                            "schema": {
                                                "type": "string",
                                                "min_length": 8,
                                                "required": true,
                                                "private": true
                                            }
                                        }
                                    ]
                                }
                            },
                            {
                                "variable": "multi_mode",
                                "label": "Multi Mode (SNMD or MNMD) Configuration",
                                "description": "For Single Node Multi Drive (SNMD), the entry will look like this:</br>\nExample Entry - /data{1...4}</br></br>\nFor Multi Node Multi Drive (MNMD), the entry will look like this:</br>\nExample Entry - https://minio{1...3}.example.com:31000/data{1...4}</br></br>\nNote that each host must use the same port number and the same number of storage items.</br>\nIn both cases /data{1...4} is the directories to be used for AIStor\u2122.\nYou have to add additional storage for each data entry.\n",
                                "schema": {
                                    "type": "dict",
                                    "attrs": [
                                        {
                                            "variable": "enabled",
                                            "label": "Enabled",
                                            "description": "Enable Multi Mode",
                                            "schema": {
                                                "type": "boolean",
                                                "default": false
                                            }
                                        },
                                        {
                                            "variable": "entries",
                                            "label": "Multi Mode (SNMD or MNMD) Entries",
                                            "schema": {
                                                "type": "list",
                                                "show_if": [
