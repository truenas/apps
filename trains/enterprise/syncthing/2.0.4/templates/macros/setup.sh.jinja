{% macro setup_script(values, settings) -%}
{%- set config_dir = "%s/config"|format(values.consts.home_path) %}
{%- set cli = "syncthing cli --home %s config"|format(config_dir) %}
#!/bin/sh
set -e
trap cleanup EXIT TERM

{# Temporary set a fixed API key so the CLI can configure Syncthing #}
STGUIAPIKEY_VALUE="$(tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32)"
export STGUIAPIKEY="${STGUIAPIKEY_VALUE}"

cleanup() {
    echo "Gracefully stopping Syncthing..."
    if kill -0 $SYNCTHING_PID > /dev/null 2>&1; then
        kill -SIGTERM $SYNCTHING_PID
        wait $SYNCTHING_PID
    fi
    echo "Syncthing stopped."
}
{#
  On the first v2 start, Syncthing migrates its database (index-v0.14.0.db -> index-v2)
  and does not serve the API until it is done. On big setups that can take a lot longer
  than any timeout we would pick, so instead of giving up after N tries, we wait for as
  long as Syncthing itself is alive and only bail out if the process goes away.
#}
wait_for() {
    local desc=$1
    local cmd=$2
    local waited=0
    until eval "$cmd"; do
        if ! kill -0 $SYNCTHING_PID > /dev/null 2>&1; then
            echo "Syncthing exited while waiting for [$desc]. Exiting..."
            exit 1
        fi
        waited=$((waited+1))
        if [ $((waited % 15)) -eq 0 ]; then
            echo "Still waiting for [$desc] after [$waited] seconds..."
        fi
        sleep 1
    done
}
echo "Starting Syncthing in the background"
/bin/entrypoint.sh /bin/syncthing &
SYNCTHING_PID=$!
echo "Syncthing started with PID [$SYNCTHING_PID]"

if [ -d '{{ config_dir }}/index-v0.14.0.db' ] && [ ! -d '{{ config_dir }}/index-v2' ]; then
    echo "Found a database in the old (v1) format."
    echo "Syncthing will migrate it, this can take a long time on large setups."
    echo "Do not stop the app while the migration is running."
fi

echo "Waiting for Syncthing to be ready..."
wait_for "config file" "[ -f '{{ config_dir }}/config.xml' ]"
wait_for "API" "curl --silent --output /dev/null http://127.0.0.1:{{ values.network.web_port.port_number }}/rest/noauth/health"
echo "Syncthing is ready."

{%- for cfg in settings %}
echo 'Using subcommand [{{ cfg.cmd }}] to set value [{{ '\"%s\"' | format(cfg.value) if cfg.quote else cfg.value }}]'
{{ cli }} {{ cfg.cmd }} set -- {{ '"%s"' | format(cfg.value) if cfg.quote else cfg.value }} || { echo "Failed to apply. Exiting..."; exit 1; }
{%- endfor %}

echo "Gracefully stopping Syncthing..."
kill -SIGTERM $SYNCTHING_PID
wait $SYNCTHING_PID
echo "Syncthing stopped."
{%- endmacro %}
