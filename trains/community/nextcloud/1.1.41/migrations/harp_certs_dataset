#!/usr/bin/python3

import os
import sys
import yaml


def migrate(values):
    # HaRP certs defaulted to the talk recording dataset, move them to their own
    ix_vol_config = values.get("storage", {}).get("harp_certs", {}).get("ix_volume_config", {})
    if ix_vol_config.get("dataset_name") == "talk_recording_data":
        ix_vol_config["dataset_name"] = "harp_certs"
    return values


if __name__ == "__main__":
    if len(sys.argv) != 2:
        exit(1)

    if os.path.exists(sys.argv[1]):
        with open(sys.argv[1], "r") as f:
            print(yaml.dump(migrate(yaml.safe_load(f.read()))))
