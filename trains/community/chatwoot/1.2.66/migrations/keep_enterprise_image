#!/usr/bin/python3

import os
import sys
import yaml


def migrate(values):
    # The image selector was ignored until now and every install ran the Enterprise image.
    # Keep existing installs on it, regardless of the selected value.
    values["chatwoot"]["image_selector"] = "image"
    return values


if __name__ == "__main__":
    if len(sys.argv) != 2:
        exit(1)

    if os.path.exists(sys.argv[1]):
        with open(sys.argv[1], "r") as f:
            print(yaml.dump(migrate(yaml.safe_load(f.read()))))
