#!/usr/bin/python3

import os
import sys

if __name__ == "__main__":
    if len(sys.argv) != 2:
        exit(1)

    print(
        "Upgrading to Wiki.js 3.x from 2.x is not supported, Wiki.js 3 cannot upgrade a 2.x installation in place. "
        "Please export your data from 2.x (Administration > Utilities > Export for Wiki.js 3.x), "
        "perform a clean install and import it there. "
        "See https://docs.js.wiki/setup/upgrade for more details.",
        file=sys.stderr,
    )
    sys.exit(os.EX_CONFIG)
