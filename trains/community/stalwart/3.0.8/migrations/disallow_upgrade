#!/usr/bin/python3

import os
import sys

if __name__ == "__main__":
    if len(sys.argv) != 2:
        exit(1)

    print(
        "Upgrading to Stalwart v1.x from v0.16.x is not supported, Stalwart v1 cannot open a v0.16 data store. "
        "Please perform a clean install and migrate your data with stalwart-migrate. "
        "See https://stalw.art/docs/migration/upgrade-0-16/ for more details.",
        file=sys.stderr,
    )
    sys.exit(os.EX_CONFIG)
