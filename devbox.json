{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.16.0/.schema/devbox.schema.json",
  "packages": [
    "python@3.11",
    "python311Packages.pytest",
    "python311Packages.pytest-cov",
    "python311Packages.bcrypt",
    "python311Packages.pydantic",
    "git@latest",
    "python311Packages.pyyaml@latest",
    "python311Packages.docker@latest"
  ],
  "shell": {
    "init_hook": [],
    "scripts": {
      "ports": ["./.github/scripts/port_validation.py"],
      "all-metadata": ["./.github/scripts/generate_metadata.py \"$@\""],
      "metadata": [
        "./.github/scripts/generate_metadata.py --train \"$1\" --app \"$2\""
      ],
      "lib-test": [
        "failed=0; for tests in library/*/tests; do pytest \"$tests\" -vvv || failed=1; done; find library -name __pycache__ -prune -exec rm -r {} +; exit $failed"
      ],
      "app-test": [
        "./.github/scripts/ci.py --train \"$1\" --app \"$2\" --test-file \"${3:-basic-values.yaml}\" --wait=true"
      ],
      "app-render": [
        "./.github/scripts/ci.py --train \"$1\" --app \"$2\" --test-file \"${3:-basic-values.yaml}\" --render-only=true"
      ],
      "app-render-debug": [
        "./.github/scripts/ci.py --train \"$1\" --app \"$2\" --test-file \"${3:-basic-values.yaml}\" --render-only-debug=true"
      ],
      "copy-lib": [
        "docker run --platform linux/amd64 --quiet --rm -e FAKE_ENV=1 -v $PWD:/workspace ghcr.io/truenas/apps_validation:slim apps_catalog_hash_generate --path /workspace"
      ],
      "prepare-libs": ["python .github/scripts/prepare_libs.py \"$@\""],
      "validate": [
        "docker run --platform linux/amd64 --quiet --rm -e FAKE_ENV=1 -v $PWD:/workspace ghcr.io/truenas/apps_validation:slim apps_dev_charts_validate validate --path /workspace"
      ]
    }
  }
}
