#!/usr/bin/python3
# Migration for openclaw 1.0.70: config volume now mounts to /home/node/.openclaw
# instead of shadowing /home/node, preserving image-bundled browser caches in ~/.cache.

import os
import sys
import yaml


def migrate(values):
    return values


if __name__ == "__main__":
    if len(sys.argv) != 2:
        exit(1)

    if os.path.exists(sys.argv[1]):
        with open(sys.argv[1], "r") as f:
            print(yaml.dump(migrate(yaml.safe_load(f.read()))))
