#!/usr/bin/python3

import os
import sys
import yaml


def migrate(values):
    # Auth Token had no effect before, so some users set the env instead.
    # Clear the field, so the env keeps working and does not clash with it.
    config = values["zerotier"]
    env_names = {env["name"] for env in config.get("additional_envs", [])}
    if "ZEROTIER_API_SECRET" in env_names:
        config["auth_token"] = ""

    return values


if __name__ == "__main__":
    if len(sys.argv) != 2:
        exit(1)

    if os.path.exists(sys.argv[1]):
        with open(sys.argv[1], "r") as f:
            print(yaml.dump(migrate(yaml.safe_load(f.read()))))
